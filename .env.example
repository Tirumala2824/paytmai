# Supabase Configuration
NEXT_SUPABASE_URL=https://sqqxknuumhbwxokbnjtr.supabase.co
# Published / Anon key (use either or both)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-publishable-key
NEXT_SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key
# Secret / Service Role key (use either or both)
SUPABASE_SERVICE_ROLE_KEY=placeholder-secret-key
SUPABASE_SECRET_KEY=placeholder-secret-key

# Database Connection (Supabase PostgreSQL)
# You can replace this with your Supabase Postgres connection strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/havendex?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/havendex?schema=public"

# Application URL
NEXT_APP_URL=http://localhost:3000

# ==========================================
# AI CONFIGURATION (Gemini)
# ==========================================
# Add your Google Gemini API key here to activate dynamic LLM reasoning and response synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Dynamic Gemini Model: 'gemini-1.5-flash', 'gemini-2.0-flash', 'gemini-1.5-pro'
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# VOICE INTEGRATION (Sarvam AI)
# ==========================================
SARVAM_API_KEY=your_sarvam_api_key_here

# ==========================================
# MEMORY INTEGRATION (Cognee)
# ==========================================
COGNEE_API_KEY=your_cognee_api_key_here

# ==========================================
# PAYMENTS (Paytm Adapter)
# ==========================================
PAYTM_MID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=WEBSTAGING
