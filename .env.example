# Supabase Configuration
NEXT_SUPABASE_URL=https://sqqxknuumhbwxokbnjtr.supabase.co
# Published / Anon key (use either or both)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-publishable-key
NEXT_SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key
# Secret / Service Role key (use either or both)
SUPABASE_SERVICE_ROLE_KEY=placeholder-secret-key
SUPABASE_SECRET_KEY=placeholder-secret-key

# Database Connection (Supabase PostgreSQL via Prisma)
# Pooled connection URL (used by runtime application queries)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true"
# Direct connection URL (used by Prisma migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Application Base URL
NEXT_APP_URL=http://localhost:3000

# ==============================================================================
# AI CONFIGURATION (Google Gemini — LLM Text Models)
# ==============================================================================
# Add your Google Gemini API key to activate dynamic LLM reasoning and response synthesis
GEMINI_API_KEY=your_gemini_api_key_here

# LLM model for text chat and intent detection.
# Options (fastest to slowest / cheapest to best):
#   gemini-3.7-flash   — Fastest, lighter, great for simple Q&A and rent checks
#   gemini-3.8-flash   — Best balance of speed + quality (RECOMMENDED default)
#   gemini-2.5-pro     — Highest quality for complex analysis (owner portfolio mode)
#   gemini-1.5-flash   — Legacy fallback
#   gemini-1.5-pro     — Legacy higher quality
# NOTE: gemini-3.8-live is a real-time voice streaming model (WebSocket only).
#       It is NOT used in the REST chat API. It is reserved for future Live Voice mode.
GEMINI_MODEL=gemini-3.8-flash

# ==============================================================================
# VOICE INTEGRATION (Sarvam AI — Speech Models)
# ==============================================================================
# Add your Sarvam API key for Indic Speech-to-Text (Saaras) and Text-to-Speech (Bulbul)
SARVAM_API_KEY=your_sarvam_api_key_here

# Speech-to-Text (STT) model — microphone audio → text transcript
# Options:
#   saaras:v3   — Latest, most accurate for 10+ Indian languages (RECOMMENDED)
#   saaras:v2   — Legacy fallback
# NOTE: gemini-3.8-live supports real-time audio but requires WebSocket (not REST).
#       It is shown as "Coming Soon" in the UI model selector.
SARVAM_STT_MODEL=saaras:v3

# Text-to-Speech (TTS) model — AI text response → audio playback
# Options:
#   bulbul:v3   — Latest, natural expressive voice in Indian languages (RECOMMENDED)
#   bulbul:v2   — Legacy fallback
SARVAM_TTS_MODEL=bulbul:v3

# Vision model for maintenance photo analysis (AI image verification)
# Options:
#   sarvam-vision  — Analyses repair photos to confirm fix, returns confidence score
#   disabled       — Skips AI photo analysis, uses manual evidence text only
# NOTE: sarvam-vision is NOT an audio model. It is a multimodal image understanding model
#       used specifically when tenants upload a photo to verify a maintenance repair.
SARVAM_VISION_MODEL=sarvam-vision

# ==============================================================================
# MEMORY INTEGRATION (Cognee)
# ==============================================================================
# Add your Cognee API key for semantic rental memory graph
COGNEE_API_KEY=your_cognee_api_key_here
COGNEE_API_URL=https://api.cognee.ai

# ==============================================================================
# PAYMENTS (Paytm Adapter)
# ==============================================================================
PAYTM_MID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_ENV=staging

# ==============================================================================
# DETERMINISTIC DEMO MODE
# ==============================================================================
# Set to 'true' to enable deterministic hackathon demo mode with zero external dependency
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
